# Copy to .env and fill in. Never commit .env - it is gitignored.
#
# The engine runs with NO keys at all: LIFELINE_OFFLINE=1 keeps every step local
# and the deterministic solver produces the 70/30 split. Keys add live calls.

# --- Nebius Token Factory ---------------------------------------------------
# Console: https://studio.nebius.com -> API keys
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tier -> model. The defaults live in brain.py; override only if the catalogue
# changes. Prices are read from the catalogue, not typed here.
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_DEEP=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_DECISION=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_REASONING_EFFORT=low
NEBIUS_MAX_TOKENS=6000

# --- Tavily -----------------------------------------------------------------
# Console: https://app.tavily.com -> API keys. Used by evidence.py only.
TAVILY_API_KEY=

# --- Local speech -----------------------------------------------------------
# MMS-TTS is an open-weight model that runs on this laptop's CPU.
# It is not an NVIDIA model, it is not a Nebius endpoint, and it costs $0.00.
# No configuration is needed; voice_synth.py downloads the checkpoint once.

# --- Behaviour --------------------------------------------------------------
# 1 = no network calls anywhere (CI, flight mode, the offline demo path)
LIFELINE_OFFLINE=0
LIFELINE_LEDGER=credit_usage.json
