# LIFELINE AI - environment template
# Copy to .env and fill in. .env is gitignored; never commit it.
#
# No key is required. With LIFELINE_OFFLINE=1 every step runs locally and the
# deterministic solver still returns the 70/30 split. Keys only add live calls.

# --- Nebius Token Factory ---------------------------------------------------
# Console: https://studio.nebius.com -> API keys
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tier -> model. Defaults live in brain.py; override only if the catalogue
# changes. Prices are read from the catalogue, not typed here.
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_DEEP=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_DECISION=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_REASONING_EFFORT=low
NEBIUS_MAX_TOKENS=6000

# --- Tavily -----------------------------------------------------------------
# Console: https://app.tavily.com -> API keys. Used by evidence.py only.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# --- Evidence region --------------------------------------------------------
# Comma-separated terms the five-check verifier uses for the regional test.
# Empty uses the Kottur set: pollachi, valparai, coimbatore, tamil nadu,
# nilgiris, anamalai, kerala. Pointing the product at another town is a config
# change, not a patch.
LIFELINE_REGION_TERMS=

# --- Local speech -----------------------------------------------------------
# MMS-TTS is an open-weight model that runs on this laptop's CPU.
# It is not an NVIDIA model, it is not a Nebius endpoint, and it costs $0.00.
# The checkpoint namespace is resolved at load time; set a prefix only for a
# mirror or a fully offline install.
LIFELINE_TTS_REPO_PREFIX=

# --- Behaviour --------------------------------------------------------------
# 1 = no network calls anywhere (CI, flight mode, the offline demo path)
LIFELINE_OFFLINE=0
# Append-only local ledger. The page and the CLI report the artefact-reconciled
# spend instead; this file is the per-machine record, not the product total.
LIFELINE_LEDGER=credit_usage.json

# --- Container --------------------------------------------------------------
# Read by deploy/serve.py. Ignored when running the scripts directly.
PORT=8080
